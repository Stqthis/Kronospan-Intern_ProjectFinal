# Copy to .env and adjust. `docker compose` reads .env automatically.

# Match the container user to yours so the bind-mounted files stay readable.
#   UID=$(id -u)  GID=$(id -g)
UID=1000
GID=1000

# Where your source PDFs/Excels live on the host (mounted read-only at /files).
FILES_DIR=./files

# Shared secret for the API. Leave EMPTY only if the port stays on localhost.
# Any non-empty value makes every endpoint except /health require
# `X-Api-Key: <value>`. Generate one:  openssl rand -hex 24
RAG_API_KEY=

# Interface bindings. 127.0.0.1 keeps services off the network entirely.
# Widen to 0.0.0.0 ONLY on a trusted subnet and ONLY with RAG_API_KEY set.
API_BIND=127.0.0.1
OLLAMA_BIND=127.0.0.1

# Model override for smaller machines, e.g. qwen2.5-coder:14b
RAG_CHAT_MODEL=qwen2.5-coder:32b
